# ── Backend API ──────────────────────────────────────────────────────────────
# URL of the running FastAPI backend — do NOT add /api/v1 (already in the routes)
VITE_API_URL=http://127.0.0.1:8000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Add http://localhost:5173 to Authorised JavaScript origins
# Same value as GOOGLE_CLIENT_ID in backend/...env
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
# ── Google Maps ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Enable "Geocoding API" → Credentials → Create API Key
# Same value as GOOGLE_MAPS_API_KEY in backend/...env
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# NOTE: DATABASE_URL, GEMINI_API_KEY, OPENAI_API_KEY and SECRET_KEY
# are backend-only — set them in backend/...env, not here.
