# ── Database ────────────────────────────────────────────────────────────────
# Supabase connection string — must use postgresql+asyncpg:// (not postgresql://)
# Find it in: Supabase dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql+asyncpg://user:password@db.xxxx.supabase.co:5432/postgres

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-generated-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Same value as VITE_GOOGLE_CLIENT_ID in frontend/...env
GOOGLE_CLIENT_ID=your-google-client-id-here

# ── LinkedIn OAuth ───────────────────────────────────────────────────────────
# linkedin.com/developers → My Apps → Auth → Client ID / Client Secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# github.com/settings/applications/new → Register a new OAuth application
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

FRONTEND_URL=http://localhost:5173

# ── AI — at least one key required for real generation, otherwise uses mock ──
# Gemini: aistudio.google.com → Get API key → Create API key (new project)
GEMINI_API_KEY=

# OpenAI: platform.openai.com/api-keys (requires API credits, separate from ChatGPT Pro)
OPENAI_API_KEY=

# Priority: Gemini → OpenAI → mock data (set only one or leave both empty for mock)

# ── Google Maps ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Enable "Geocoding API" → Credentials → Create API Key
# Same value as VITE_GOOGLE_MAPS_API_KEY in frontend/...env
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Geocoding fallback (optional) ────────────────────────────────────────────
# opencagedata.com — used if GOOGLE_MAPS_API_KEY is not set
OPENCAGE_API_KEY=

# ── Localisation ─────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
